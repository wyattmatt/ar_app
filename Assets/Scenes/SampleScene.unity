  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ikuti 3 langkah berikut untuk memindai komponen instalasi:\n\n<b>1. Arahkan Kamera ke Komponen</b>\r\n<size=85%><color=#475569>Fokuskan kamera ponsel ke arah panel dinding, boks splitter, roll cable, atau papan SOP.</color></size>\r\n\r\n<b>2. Jaga Jarak & Pencahayaan</b>\r\n<size=85%><color=#475569>Posisikan kamera berjarak sekitar 30\u201350 cm dengan kondisi cahaya ruangan yang cukup terang.</color></size>\r\n\r\n<b>3. Baca Kartu Panduan AR</b>\r\n<size=85%><color=#475569>Kartu informasi pengecekan dan troubleshooting akan muncul otomatis di atas komponen yang terdeteksi.</color></size>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
